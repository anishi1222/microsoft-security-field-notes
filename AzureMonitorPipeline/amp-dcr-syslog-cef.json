{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "dataCollectionRuleName": {
      "type": "string",
      "defaultValue": "myaks-dcr-test",
      "metadata": { "description": "DCR の名前。サブスクリプションに対して一意。" }
    },
    "location": {
      "type": "string",
      "defaultValue": "japaneast",
      "metadata": { "description": "DCR の場所。DCE と一致させる。" }
    },
    "dataCollectionEndpointId": {
      "type": "string",
      "defaultValue": "/subscriptions/8c17e3ac-5866-4598-bea9-e4fe5f13dc86/resourceGroups/rg-rebind-sender-test/providers/Microsoft.Insights/dataCollectionEndpoints/myaks-dce-test",
      "metadata": { "description": "先に作成した DCE のリソース ID。" }
    },
    "workspaceResourceId": {
      "type": "string",
      "defaultValue": "/subscriptions/8c17e3ac-5866-4598-bea9-e4fe5f13dc86/resourceGroups/rg-rebind-sender-test/providers/Microsoft.OperationalInsights/workspaces/rebind-law-test",
      "metadata": { "description": "送信先 Log Analytics ワークスペース (rebind-law-test) の ID。" }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "[parameters('dataCollectionRuleName')]",
      "location": "[parameters('location')]",
      "properties": {
        "dataCollectionEndpointId": "[parameters('dataCollectionEndpointId')]",
        "streamDeclarations": {},
        "dataSources": {},
        "destinations": {
          "logAnalytics": [
            {
              "name": "rebind-law-test",
              "workspaceResourceId": "[parameters('workspaceResourceId')]"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [ "Microsoft-CommonSecurityLog-FullyFormed" ],
            "destinations": [ "rebind-law-test" ],
            "transformKql": "source | where isnotempty(DeviceVendor)",
            "outputStream": "Microsoft-CommonSecurityLog"
          },
          {
            "streams": [ "Microsoft-Syslog-FullyFormed" ],
            "destinations": [ "rebind-law-test" ],
            "transformKql": "source | where isnull(SyslogMessage) or SyslogMessage !has 'CEF:'",
            "outputStream": "Microsoft-Syslog"
          }
        ]
      }
    }
  ],
  "outputs": {
    "dcrImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName')), '2023-03-11').immutableId]"
    }
  }
}